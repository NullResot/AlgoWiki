# Dedicated test environment. Never reuse production credentials here.
APP_ENV_FILE=deploy/.env.test
COMPOSE_PROJECT_NAME=algowiki_test
APP_IMAGE=ghcr.io/example/algowiki-web:test
APP_IMAGE_REPOSITORY=ghcr.io/example/algowiki-web
GITHUB_REPOSITORY=example/AlgoWiki
GITHUB_BRANCH=test
DEPLOY_SYNC_GITHUB_BRANCH=1
REDIS_IMAGE=ghcr.io/nullresot/algowiki-redis@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<TEST_DJANGO_SECRET_KEY>
AI_ASSISTANT_ENCRYPTION_KEY=<TEST_FERNET_KEY>
DJANGO_ALLOWED_HOSTS=test.example.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://test.example.com
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
TRUST_X_FORWARDED_FOR=1
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

APP_BIND=127.0.0.1
APP_PORT=8002
GUNICORN_WORKERS=2
GUNICORN_GRACEFUL_TIMEOUT=125
REDIS_URL=redis://redis:6379/1
APP_LOG_DIR=/srv/algowiki/storage/logs/test
DJANGO_LOG_DIR=/app/storage/logs
REDIS_MAXMEMORY=64mb
REDIS_MEMORY_LIMIT=96m
REDIS_CPU_LIMIT=0.10
REDIS_PIDS_LIMIT=64
WEB_MEMORY_LIMIT=512m
WEB_CPU_LIMIT=0.50
WEB_PIDS_LIMIT=192
WORKER_MEMORY_LIMIT=192m
WORKER_CPU_LIMIT=0.20
WORKER_PIDS_LIMIT=96

DB_ENGINE=mysql
DB_HOST=<TEST_DB_HOST>
DB_PORT=3306
DB_NAME=algowiki_test
DB_USER=<TEST_DB_USER>
DB_PASSWORD=<TEST_DB_PASSWORD>
DB_CHARSET=utf8mb4
DB_CONN_MAX_AGE=300

SITE_NAME=AlgoWiki Test
PUBLIC_SITE_URL=https://test.example.com
MEDIA_ROOT=/srv/algowiki-test/media
MEDIA_URL=/media/
FRONTEND_DIST_DIR=/srv/algowiki-test/frontend/dist

SUPERADMIN_USERNAME=test-superadmin
SUPERADMIN_PASSWORD=<TEST_SUPERADMIN_PASSWORD>
SUPERADMIN_EMAIL=<TEST_SUPERADMIN_EMAIL>

CAPTCHA_ENABLED=1
TURNSTILE_SITE_KEY=<TEST_TURNSTILE_SITE_KEY>
TURNSTILE_SECRET_KEY=<TEST_TURNSTILE_SECRET_KEY>
